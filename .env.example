# APEX Food — contrato de ambientes
# Copie para um arquivo local não versionado somente quando necessário.
# Nunca coloque valores reais neste arquivo.

# Ambiente: development | preview | production
APP_ENV=development

# Firebase Web — identificadores públicos
FIREBASE_PROJECT_ID=apex-food-6c1cb
FIREBASE_AUTH_DOMAIN=apex-food-6c1cb.firebaseapp.com
FIREBASE_STORAGE_BUCKET=apex-food-6c1cb.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=771860546633
FIREBASE_APP_ID=1:771860546633:web:4e609e3c334ed02d352b98
FIREBASE_WEB_API_KEY=replace-with-firebase-web-api-key

# Backend server-side — obrigatórios somente nas funções da Vercel
FIREBASE_CLIENT_EMAIL=replace-with-server-service-account-email
FIREBASE_PRIVATE_KEY=replace-with-server-private-key
SESSION_SECRET=replace-with-long-random-session-secret
CSRF_SECRET=replace-with-long-random-csrf-secret
SESSION_TTL_SECONDS=28800

# Proteções e serviços server-side
# off em Development; observe para homologação; enforce antes do go-live
APP_CHECK_MODE=off
RATE_LIMIT_URL=replace-with-distributed-rate-limit-endpoint
RATE_LIMIT_TOKEN=replace-with-rate-limit-token

# Domínios e CORS
APP_ORIGIN=http://localhost:4173
ALLOWED_ORIGINS=http://localhost:4173

# Não exponha nenhuma variável acima no bundle público.
