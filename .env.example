# Copie estas chaves para as Environment Variables do projeto na Vercel
# (Project Settings → Environment Variables). Nenhum valor real aqui —
# são só os nomes que o app espera encontrar em process.env.

# ---- Firebase (client SDK — pode ficar público, roda no navegador) ----
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- Firebase Admin SDK (server-side — SECRETO, não expor) ----
# Console Firebase > Configurações do projeto > Contas de serviço > Gerar nova chave privada
FIREBASE_CLIENT_EMAIL=
# Cole o PEM completo (-----BEGIN PRIVATE KEY-----...-----END PRIVATE KEY-----).
# Se colar sem aspas na Vercel, tudo bem — src/lib/firebase-admin.ts já limpa
# aspas externas e normaliza as quebras de linha "\n" automaticamente.
FIREBASE_PRIVATE_KEY=

# ---- Tempo real (opcional) ----
# URL pública de um mini-services/realtime-service hospedado à parte — a
# Vercel é serverless e não roda um servidor Socket.IO persistente. Sem
# essas variáveis, o app funciona normalmente (as telas se atualizam
# sozinhas a cada 15s) — só perde as notificações instantâneas.
# REALTIME_URL=
# NEXT_PUBLIC_REALTIME_URL=
