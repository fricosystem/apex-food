generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============ APEX FOOD — SaaS multi-restaurantes ============

/** Plano comercial disponível na plataforma */
model Plan {
  id        String @id @default(cuid())
  key       String @unique // TRIAL | BASIC | PRO | PREMIUM
  name      String
  price     Float  @default(0) // mensalidade (BRL)
  duration  Int    @default(30) // dias por período de cobrança
  features  String @default("") // recursos, um por linha
  sortOrder Int    @default(0)
}

/** Estabelecimento (tenant) — cada restaurante da plataforma */
model Establishment {
  id               String    @id @default(cuid())
  name             String
  cnpj             String    @default("")
  logo             String    @default("🍴")
  type             String    @default("RESTAURANTE")
  phone            String    @default("")
  address          String    @default("")
  active           Boolean   @default(true)
  // ---- Plano e cobrança ----
  plan             String    @default("TRIAL") // TRIAL | BASIC | PRO | PREMIUM (key do Plan)
  billingStatus    String    @default("TRIAL") // TRIAL | PAID | OVERDUE | CANCELED
  trialEndsAt      DateTime? // fim do período de teste
  currentPeriodEnd DateTime? // vencimento do período pago
  lastPaymentAt    DateTime?
  notes            String    @default("")
  // Overrides de permissão por tela: { "dashboard": ["ADMIN"], ... }
  permissions      String    @default("{}")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  users            User[]
  tables           RestaurantTable[]
  categories       Category[]
  products         Product[]
  orders           Order[]
  goals            Goal[]
  settings         Setting[]
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  password       String
  role           String   @default("WAITER") // SUPER_ADMIN | ADMIN | MANAGER | WAITER | KITCHEN | CASHIER
  status         String   @default("ONLINE") // ONLINE | BUSY | OFFLINE
  active         Boolean  @default(true)
  establishmentId String?
  establishment  Establishment? @relation(fields: [establishmentId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  assignedOrders Order[]
  goals          Goal[]
  payments       Payment[]
}

model RestaurantTable {
  id             String    @id @default(cuid())
  number         Int
  capacity       Int       @default(4)
  active         Boolean   @default(true)
  status         String    @default("FREE") // FREE | OCCUPIED | AWAITING_PAYMENT
  qrToken        String    @unique
  establishmentId String?
  establishment  Establishment? @relation(fields: [establishmentId], references: [id])
  createdAt      DateTime  @default(now())
  orders         Order[]

  @@unique([establishmentId, number])
}

model Category {
  id              String    @id @default(cuid())
  name            String
  sector          String    @default("KITCHEN") // KITCHEN | GRILL | PIZZERIA | BAR
  icon            String    @default("🍽️")
  sortOrder       Int       @default(0)
  active          Boolean   @default(true)
  establishmentId String?
  establishment   Establishment? @relation(fields: [establishmentId], references: [id])
  createdAt       DateTime  @default(now())
  products        Product[]

  @@unique([establishmentId, name])
}

model Product {
  id         String      @id @default(cuid())
  name       String
  description String     @default("")
  image      String?
  emoji      String      @default("🍽️")
  price      Float
  prepTime   Int         @default(15) // minutos
  kind       String      @default("PRODUCT") // PRODUCT | MEAL
  active     Boolean     @default(true)
  categoryId String
  category   Category    @relation(fields: [categoryId], references: [id])
  establishmentId String?
  establishment   Establishment? @relation(fields: [establishmentId], references: [id])
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  items      OrderItem[]
}

model Order {
  id            String           @id @default(cuid())
  code          String
  tableId       String
  table         RestaurantTable  @relation(fields: [tableId], references: [id])
  waiterId      String?
  waiter        User?            @relation(fields: [waiterId], references: [id])
  establishmentId String?
  establishment   Establishment?   @relation(fields: [establishmentId], references: [id])
  status        String           @default("PENDING_CONFIRM") // PENDING_CONFIRM | IN_KITCHEN | AWAITING_PAYMENT | PAID | CANCELLED
  total         Float            @default(0)
  createdAt     DateTime         @default(now())
  confirmedAt   DateTime?
  finishedAt    DateTime?
  paidAt        DateTime?
  rating        Int? // avaliação do cliente pós-pagamento (1 a 5)
  ratedAt       DateTime?
  items         OrderItem[]
  payments      Payment[]

  @@unique([establishmentId, code])
}

model OrderItem {
  id          String    @id @default(cuid())
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  productName String
  quantity    Int       @default(1)
  notes       String    @default("")
  unitPrice   Float
  station     String    @default("KITCHEN") // KITCHEN | GRILL | PIZZERIA | BAR
  prepTime    Int       @default(15)
  status      String    @default("PENDING") // PENDING | IN_PREPARATION | READY | SERVED
  startedAt   DateTime?
  readyAt     DateTime?
  servedAt    DateTime?
}

model Payment {
  id        String    @id @default(cuid())
  orderId   String
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method    String // CREDIT | DEBIT | PIX | CASH
  amount    Float
  cashierId String?
  cashier   User?     @relation(fields: [cashierId], references: [id])
  createdAt DateTime  @default(now())
}

model Goal {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  title           String
  target          Int      @default(20) // comandas no mês
  month           String // YYYY-MM
  active          Boolean  @default(true)
  establishmentId String?
  establishment   Establishment? @relation(fields: [establishmentId], references: [id])
  createdAt       DateTime @default(now())
}

model Setting {
  id              String @id @default(cuid())
  key             String
  value           String
  establishmentId String?
  establishment   Establishment? @relation(fields: [establishmentId], references: [id])

  @@unique([establishmentId, key])
}
