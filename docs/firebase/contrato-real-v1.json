      "mutacao": ["funcionario", "escala"],
      "colecoes": ["funcionarios", "dadosPrivadosFuncionarios", "escalas", "comissoes"]
    },
    "/api/v1/financeiro": {
      "metodos": ["GET", "POST", "PATCH"],
      "leitura": ["resumos", "relatorios", "contas", "movimentacoes", "fechamentos"],
      "mutacao": ["conta", "movimentacao", "fechamento"],
      "colecoes": ["fechamentosCaixa", "movimentacoesCaixa", "contasPagar", "contasReceber", "relatoriosFinanceiros", "resumosFinanceiros", "chavesIdempotencia"]
