# APEX Food — contrato de Staging/homologação
# Este arquivo contém somente placeholders. Não substitua por valores reais no Git.
# Aplicar exclusivamente ao ambiente Preview/Staging da Vercel.

APP_ENV=preview

# Projeto Firebase separado do Development e da Production
FIREBASE_PROJECT_ID=replace-with-staging-firebase-project-id
FIREBASE_AUTH_DOMAIN=replace-with-staging-project.firebaseapp.com
FIREBASE_STORAGE_BUCKET=replace-with-staging-storage-bucket
FIREBASE_MESSAGING_SENDER_ID=replace-with-staging-sender-id
FIREBASE_APP_ID=replace-with-staging-web-app-id
FIREBASE_WEB_API_KEY=replace-with-staging-web-api-key

# Credenciais exclusivamente server-side, inseridas diretamente na Vercel
FIREBASE_CLIENT_EMAIL=replace-with-staging-service-account-email
FIREBASE_PRIVATE_KEY=replace-with-staging-private-key
SESSION_SECRET=replace-with-staging-session-secret
CSRF_SECRET=replace-with-staging-csrf-secret
SESSION_TTL_SECONDS=28800

# Homologação começa observando App Check; só promover para enforce após evidências
APP_CHECK_MODE=observe
RATE_LIMIT_URL=replace-with-staging-distributed-rate-limit-endpoint
RATE_LIMIT_TOKEN=replace-with-staging-rate-limit-token

# URL HTTPS estável de Preview/Staging, sem curingas
APP_ORIGIN=https://replace-with-staging-origin.vercel.app
ALLOWED_ORIGINS=https://replace-with-staging-origin.vercel.app
