rules_version = '2';

// Todo o acesso ao Firestore passa pelo Next.js (rotas /api/**) usando o
// Firebase Admin SDK, que ignora estas regras por design — quem valida
// permissão de acesso é a própria API (src/lib/api.ts: requireUser /
// requireTenant), da mesma forma que já acontecia com o Prisma.
//
// Por isso o client SDK (navegador) nunca deve ler/escrever Firestore
// diretamente nesta fase da migração: fica tudo negado abaixo.
//
// Se um dia o app passar a usar onSnapshot() direto do navegador (ver
// plano_firebase.md, Fase 8 — tempo real), estas regras precisarão ser
// reescritas para liberar leitura por tenant/papel.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
